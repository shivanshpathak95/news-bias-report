# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Model used for the agent loop and final structured analysis
GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key — https://app.tavily.com/
TAVILY_API_KEY=

# Port for the Express API server (Stage 2+)
PORT=3001

# --- Tuning for Groq's free-tier rate limits ---
# A free-tier account has a modest tokens-per-minute budget, and since every
# turn resends the whole growing conversation, fetched article text is the
# main thing to keep small. Raise these if you're on a paid tier.
ARTICLE_MAX_WORDS=350
MIN_SOURCES=3
MAX_SOURCES=6
TOOL_CALL_BUDGET=16
